  <meta name="twitter:description" content="A code-first guide to AI agents, agentic workflows, MCP, and AI frameworks. Updated 2026." />
  <meta name="twitter:image" content="https://agentguides.dev/og-default.png" />
  <link rel="canonical" href="https://agentguides.dev/" />

  <!-- Fonts: Geist (text and display), Geist Mono (data) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        'name': 'AgentGuide',
        'alternateName': ['AI Agents & Agentic Workflows Guide', 'AI Agents Guide'],
        'url': 'https://agentguides.dev',
        'description': 'A code-first guide to AI agents, agentic workflows, MCP, LangChain, CrewAI, AutoGen, and agent design patterns.',
        'inLanguage': 'en-US',
        'publisher': { '@type': 'Person', 'name': 'Parvez Ahmed', 'url': 'https://github.com/Sero01' },
      },
      {
        '@type': 'Person',
        'name': 'Parvez Ahmed',
        'url': 'https://github.com/Sero01',
        'sameAs': [
          'https://github.com/Sero01',
          'https://www.linkedin.com/in/parvez-ahmed-b47680124',
          'https://www.instagram.com/126parvez',
        ],
      },
      {
        '@type': 'ItemList',
        'name': 'AgentGuide — main sections',
        'numberOfItems': 5,
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'url': 'https://agentguides.dev/reviews/', 'name': 'AI Tool Reviews' },
          { '@type': 'ListItem', 'position': 2, 'url': 'https://agentguides.dev/best/', 'name': 'Best-Of Guides' },
          { '@type': 'ListItem', 'position': 3, 'url': 'https://agentguides.dev/build/', 'name': 'Build Tutorials' },
          { '@type': 'ListItem', 'position': 4, 'url': 'https://agentguides.dev/leaderboard/', 'name': 'AI Models Leaderboard' },
          { '@type': 'ListItem', 'position': 5, 'url': 'https://agentguides.dev/learn/', 'name': 'Learn the Fundamentals' },
        ],
      },
    ],
  })}></script>

  <!-- Apply theme before paint to prevent flash -->
  <script is:inline>
    (function () {
      try {
        var s = localStorage.getItem('starlight-theme');
        if (s === 'dark' || s === 'light') document.documentElement.dataset.theme = s;
      } catch (e) {}
    })();
  </script>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="AgentGuide home">
      <svg class="logo-glyph" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M19.76 5.66A11 11 0 1 0 26.34 12.24" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/>
        <circle cx="16" cy="16" r="3.6" fill="currentColor"/>
        <circle cx="23.78" cy="8.22" r="3.4" class="logo-sat"/>
      </svg>
      <span class="logo-word">agent<span>guide</span></span>
    </a>

    <ul class="nav-links" id="site-nav-links">
      <li><a href="/reviews/">Reviews</a></li>
      <li><a href="/best/">Best of</a></li>
      <li><a href="/build/">Tutorials</a></li>
      <li><a href="/leaderboard/">Leaderboard</a></li>
      <li><a href="/learn/">Learn</a></li>
    </ul>

    <div class="nav-right">
      <button class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <a class="icon-btn nav-github" href="https://github.com/Sero01/ai-agents-guide" target="_blank" rel="noopener noreferrer" aria-label="Source on GitHub" title="Source on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/></svg>
      </a>
      <button class="icon-btn nav-menu-toggle" id="nav-menu-toggle" aria-controls="site-nav-links" aria-expanded="false" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path class="bar bar-1" d="M4 7h16"/><path class="bar bar-2" d="M4 12h16"/><path class="bar bar-3" d="M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<main id="main">
  <!-- ── Masthead: opens straight into the newest pages ─────────────── -->
  <section class="masthead">
    <div class="wrap">
      <h1 class="masthead-title">
        Field-tested guides for building AI&nbsp;agents<span class="loop-token" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><g class="loop-spin"><path d="M19.76 5.66A11 11 0 1 0 26.34 12.24" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/><circle cx="23.78" cy="8.22" r="3.6" class="loop-sat"/></g><circle cx="16" cy="16" r="3.8" fill="currentColor"/></svg></span>
      </h1>
      <div class="masthead-sub">
        <p>Reviews, comparisons and runnable code for agent frameworks, coding tools and the models behind them. Updated {updatedLabel}.</p>
        <a class="btn" href="/getting-started/">Start with the basics</a>
      </div>

      <div class="stories">
        <a class="story-lead" href={lead.href}>
          <h2>{lead.title}</h2>
          {lead.sub && <p class="story-sub">{lead.sub}</p>}
          <p class="story-desc">{lead.description}</p>
          <p class="story-meta">{lead.label}, <time datetime={lead.date.toISOString().slice(0, 10)}>{fmtDate(lead.date)}</time></p>
        </a>
        <ul class="story-list">
          {latest.map((s) => (
            <li>
              <a href={s.href}>
                <h3>{s.title}</h3>
                <p class="story-meta">{s.label}, <time datetime={s.date.toISOString().slice(0, 10)}>{fmtDate(s.date)}</time></p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Benchmark snapshot ─────────────────────────────────────────── -->
  <section class="section snapshot" aria-labelledby="snapshot-title">
    <div class="wrap split">
      <div class="split-aside">
        <h2 id="snapshot-title">Compare models on the benchmark that matches your work</h2>
        <p>Top current models on three widely reported benchmarks. Every score links to its source, and gaps under one point count as ties.</p>
        <a class="btn btn-accent" href="/leaderboard/">Open the full leaderboard</a>
        <p class="fine">{modelCount} models tracked. Data checked {snapshotDate}.</p>
      </div>

      <div class="board-wrap">
        <fieldset class="seg" aria-label="Benchmark">
          <legend class="sr-only">Benchmark</legend>
          {BOARDS.map((b, i) => (
            <label>
              <input type="radio" name="bench" value={b.key} checked={i === 0} />
              <span>{b.label}</span>
            </label>
          ))}
        </fieldset>

        {BOARDS.map((b) => (
          <div class="board" data-key={b.key}>
            <p class="board-note">{b.note}</p>
            <ol class="board-rows">
              {b.rows.map((r: any) => (
                <li class="board-row">
                  <span class="rank">{r.rank}</span>
                  <span class="who">
                    <span class="model">{r.name}</span>
                    <span class="vendor">{r.vendor}</span>
                  </span>
                  <span class="bar" aria-hidden="true"><span style={`--w:${r.value}%`}></span></span>
                  {r.url
                    ? <a class="score" href={r.url} target="_blank" rel="noopener" title="Source">{r.value.toFixed(1)}</a>
                    : <span class="score">{r.value.toFixed(1)}</span>}
                  <span class="price" title="Input / output price per million tokens">{r.price}</span>
                </li>
              ))}
            </ol>
            <p class="fine">Price is input / output per million tokens. Showing the top {b.rows.length} of {b.total} current models with a sourced {b.label} score.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Reviews ────────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="reviews-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="reviews-title">Know what a new model is good for before you switch</h2>
        <a class="text-link" href="/reviews/">All reviews</a>
      </div>
      <ul class="review-grid">
        {reviews.map((r) => (
          <li>
            <a href={r.href}>
              <h3>{r.title}</h3>
              {r.sub && <p>{r.sub}</p>}
              <p class="story-meta"><time datetime={r.date.toISOString().slice(0, 10)}>{fmtDate(r.date)}</time></p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Shortlists and builds (editorial split) ───────────────────── -->
  <section class="section tint" aria-labelledby="build-title">
    <div class="wrap">
      <h2 id="build-title" class="solo-head">Pick a framework, then build something real with it</h2>
      <div class="columns">
        <div>
          <h3 class="col-head">Shortlists</h3>
          <ul class="entry-list">
            {BEST_OF.map((item) => (
              <li><a href={item.href}><span class="entry-title">{item.title}</span><span class="entry-desc">{item.description}</span></a></li>
            ))}
          </ul>
          <a class="text-link" href="/best/">All shortlists</a>
        </div>
        <div>
          <h3 class="col-head">Builds and head-to-heads</h3>
          <ul class="entry-list">
            {BUILD.map((item) => (
              <li><a href={item.href}><span class="entry-title">{item.title}</span><span class="entry-desc">{item.description}</span></a></li>
            ))}
          </ul>
          <a class="text-link" href="/build/">All tutorials</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Learn ──────────────────────────────────────────────────────── -->
  <section class="section learn" aria-labelledby="learn-title">
    <div class="wrap split split-wide">
      <div class="learn-main">
        <h2 id="learn-title">Learn how agents work, starting from the loop</h2>
        <p>A curriculum if you want one, a reference if you don't. Pick where you are and follow the links in order.</p>

        <fieldset class="seg" aria-label="Level">
          <legend class="sr-only">Level</legend>
          {LEARN_PATHS.map((p, i) => (
            <label>
              <input type="radio" name="level" value={p.key} checked={i === 0} />
              <span>{p.label}</span>
            </label>
          ))}
        </fieldset>

        {LEARN_PATHS.map((p) => (
          <div class="path" data-key={p.key}>
            <p>{p.description}</p>
            <ol class="path-links">
              {p.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ol>
          </div>
        ))}
      </div>

      <figure class="loop-figure" aria-labelledby="loop-caption">
        <svg class="loop-diagram" viewBox="0 0 420 420" role="img" aria-label="The agentic loop: context goes to the model, the model calls a tool, the tool returns a result, and the result is added to context.">
          <circle class="ld-ring" cx="210" cy="210" r="150" />
          <path class="ld-arc" pathLength="100" d="M210 60 A150 150 0 1 1 209.9 60" />
          <path class="ld-arrow" d="M-7 -7 L1 0 L-7 7" transform="translate(316.1 103.9) rotate(45)" /><path class="ld-arrow" d="M-7 -7 L1 0 L-7 7" transform="translate(316.1 316.1) rotate(135)" /><path class="ld-arrow" d="M-7 -7 L1 0 L-7 7" transform="translate(103.9 316.1) rotate(225)" /><path class="ld-arrow" d="M-7 -7 L1 0 L-7 7" transform="translate(103.9 103.9) rotate(315)" />
          <g class="ld-node" style="--i:0"><circle cx="210" cy="60" r="10" /><text x="210" y="30" text-anchor="middle">Context</text></g>
          <g class="ld-node" style="--i:1"><circle cx="360" cy="210" r="10" /><text x="378" y="215" text-anchor="start">Model</text></g>
          <g class="ld-node" style="--i:2"><circle cx="210" cy="360" r="10" /><text x="210" y="398" text-anchor="middle">Tool call</text></g>
          <g class="ld-node" style="--i:3"><circle cx="60" cy="210" r="10" /><text x="42" y="215" text-anchor="end">Result</text></g>
          <text class="ld-center" x="210" y="204" text-anchor="middle">Repeat until</text>
          <text class="ld-center" x="210" y="230" text-anchor="middle">the task is done</text>
        </svg>
        <figcaption id="loop-caption">Every agent is this loop plus a stopping rule. <a href="/ai-agents/agent-loop/">Read the agentic loop</a></figcaption>
      </figure>
    </div>
  </section>

