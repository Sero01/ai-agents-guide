---
// Marketing landing page: bypasses the Starlight layout.
// Theme: "Field notes" (see src/styles/theme.css for tokens and house rules).
//
// The page opens straight into content: a masthead with the newest pages,
// then a live benchmark snapshot built from the same data as /leaderboard/.
// Lists are read from the docs collection and models.json at build time, so
// the homepage stays current without hand edits.
import { getCollection } from 'astro:content';
import SponsorBanner from '../components/SponsorBanner.astro';
import modelsData from '../data/models.json';

// ── Newest pages (masthead + reviews) ───────────────────────────────
const SECTION_LABEL: Record<string, string> = {
  reviews: 'Review',
  research: 'Research',
  'ai-agents': 'Concepts',
  best: 'Shortlist',
  build: 'Tutorial',
};

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// "Claude Opus 5 Review — Benchmarks, Pricing…" → short title + subtitle.
function splitTitle(title: string) {
  const m = title.match(/^(.+?)\s+(?:—|–|-|:)\s+(.+)$/);
  return m ? { short: m[1], sub: m[2] } : { short: title, sub: '' };
}

const docs = await getCollection('docs');
const dated = docs
  .filter((e) => e.data.date && e.id.includes('/'))
  .map((e) => {
    const { short, sub } = splitTitle(e.data.title);
    const section = e.id.split('/')[0];
    return {
      id: e.id,
      href: `/${e.id}/`,
      title: short,
      sub,
      description: e.data.description ?? '',
      label: SECTION_LABEL[section] ?? 'Guide',
      section,
      date: e.data.date as Date,
    };
  })
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const [lead, ...rest] = dated;
const latest = rest.slice(0, 4);
const shownIds = new Set([lead.id, ...latest.map((d) => d.id)]);
const reviews = dated.filter((d) => d.section === 'reviews' && !shownIds.has(d.id)).slice(0, 6);
const updatedLabel = lead.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

// ── Benchmark snapshot ──────────────────────────────────────────────
// Same rules as /leaderboard/: only first-party or independently measured
// figures are ranked, only current models, and gaps under the noise floor
// are shown as ties.
const { models, benchmark_registry, last_updated } = modelsData as any;
const fmtPrice = (n: number) => `$${Number.isInteger(n) ? n : n.toFixed(2)}`;
const RANKABLE = new Set(['vendor', 'swebench', 'lmarena', 'artificial_analysis']);
const NOISE_FLOOR = 1.0;
const BOARDS = [
  { key: 'hle', label: 'HLE', note: 'Humanity’s Last Exam, with tools. Broad reasoning under tool use.' },
  { key: 'terminal_bench_4_0', label: 'Terminal-Bench 4.0', note: 'Long-horizon tasks in a real shell. The closest public proxy for coding agents.' },
  { key: 'gpqa_diamond', label: 'GPQA Diamond', note: 'Graduate-level science questions. Saturating, but still the most widely reported.' },
].map((b) => {
  const rows = models
    .filter((m: any) => m.status === 'current')
    .map((m: any) => ({ m, cell: m.benchmarks?.[b.key] }))
    .filter(({ cell }: any) => cell && cell.value != null && RANKABLE.has(cell.source))
    .map(({ m, cell }: any) => ({
      name: m.name,
      vendor: m.vendor,
      value: cell.value as number,
      url: cell.url as string | null,
      price: m.pricing?.input != null && m.pricing?.output != null
        ? `${fmtPrice(m.pricing.input)} / ${fmtPrice(m.pricing.output)}`
        : 'n/a',
    }))
    .sort((a: any, b: any) => b.value - a.value);
  const top = rows.slice(0, 6).map((r: any) => ({
    ...r,
    rank: 1 + rows.filter((o: any) => o.value > r.value + NOISE_FLOOR - 1e-9).length,
  }));
  return { ...b, label: benchmark_registry[b.key]?.label ?? b.label, rows: top, total: rows.length };
});
const modelCount = models.length;
const snapshotDate = new Date(`${last_updated}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// ── Shortlists and builds ───────────────────────────────────────────
const BEST_OF = [
  {
    title: 'AI agent frameworks 2026',
    description: 'Ten frameworks tested, with a verdict for prototyping, production, Python, TypeScript and tight budgets.',
    href: '/best/ai-agent-frameworks-2026/',
  },
  {
    title: 'Claude Fable 5 vs Opus 4.8',
    description: 'When the premium tier earns its price, and when Opus does the same job for less.',
    href: '/best/claude-fable-5-vs-opus-4-8/',
  },
  {
    title: 'AI engineer certifications 2026',
    description: 'Coursera, AWS, GCP, Azure and DeepLearning.AI, weighed against what hiring managers actually ask for.',
    href: '/best/ai-engineer-certifications-2026/',
  },
  {
    title: 'LLM benchmark comparison 2026',
    description: 'Which benchmarks still separate models, which are saturated, and how to read a vendor chart.',
    href: '/best/llm-benchmark-comparison-2026/',
  },
];

const BUILD = [
  {
    title: 'Research agent with CrewAI',
    description: 'A three-agent research assistant, end to end. Working code, about $0.05 per run, full repo on GitHub.',
    href: '/build/research-agent-with-crewai/',
  },
  {
    title: 'CrewAI vs LangGraph vs AutoGen',
    description: 'The same assistant built three ways, with token spend, latency and a pick for each use case.',
    href: '/reviews/crewai-vs-langgraph-vs-autogen/',
  },
  {
    title: 'Claude Code vs Cursor vs Codex',
    description: 'Three coding tools on a refactor, a bug fix and a new feature, with real billing data.',
    href: '/reviews/claude-code-vs-cursor-vs-codex/',
  },
  {
    title: 'Building MCP servers',
    description: 'Expose your own tools to any MCP-compatible agent, with a server you can run today.',
    href: '/mcp/building-servers/',
  },
];

// ── Learning paths ──────────────────────────────────────────────────
const LEARN_PATHS = [
  {
    key: 'beginner',
    label: 'Beginner',
    description: 'Set up Python, learn what an agent actually is, and write your first ReAct loop in under fifty lines.',
    links: [
      { label: 'Getting started', href: '/getting-started/' },
      { label: 'What an AI agent is', href: '/ai-agents/' },
      { label: 'The agentic loop', href: '/ai-agents/agent-loop/' },
      { label: 'Prompt engineering', href: '/prompt-engineering/' },
      { label: 'Code examples', href: '/code-examples/' },
    ],
  },
  {
    key: 'intermediate',
    label: 'Intermediate',
    description: 'The recurring agent shapes, the limits token budgets impose, and how to specify behaviour in version control.',
    links: [
      { label: 'Agent patterns', href: '/ai-agents/patterns/' },
      { label: 'Tokens and context', href: '/ai-agents/tokens-context/' },
      { label: 'Agent harnesses', href: '/ai-agents/agent-harness/' },
      { label: 'Agent instructions', href: '/agent-instructions/' },
      { label: 'Tools and memory', href: '/tools-memory/' },
    ],
  },
  {
    key: 'advanced',
    label: 'Advanced',
    description: 'Multi-agent coordination, the protocol layer, and the framework trade-offs that only show up at scale.',
    links: [
      { label: 'Multi-agent pipelines', href: '/agentic-workflows/multi-agent/' },
      { label: 'What MCP is', href: '/mcp/' },
      { label: 'Building MCP servers', href: '/mcp/building-servers/' },
      { label: 'LangChain', href: '/frameworks/langchain/' },
      { label: 'CrewAI', href: '/frameworks/crewai/' },
      { label: 'AutoGen', href: '/frameworks/autogen/' },
    ],
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7347042268747630" crossorigin="anonymous"></script>

  <title>AgentGuide — Reviews, comparisons, and builds for AI agents</title>
  <meta name="description" content="Hands-on reviews, head-to-head comparisons, and build tutorials for AI agents, agent frameworks, and LLM coding tools. Interactive leaderboard with 100+ models, pricing, and benchmarks. Updated 2026." />
  <meta name="keywords" content="AI agents, AI tools, agentic workflows, MCP, Model Context Protocol, LangChain, CrewAI, AutoGen, AI frameworks, prompt engineering, multi-agent systems, AI agents 2026" />
  <meta name="author" content="Parvez Ahmed" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
