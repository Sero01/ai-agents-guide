    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
    transition: color 160ms var(--ease-out);
  }
  .review-grid p { margin-top: 0.5rem; }
  .review-grid .story-meta { color: var(--text-muted); }
  .review-grid a:hover h3 { color: var(--accent); }
  @media (max-width: 859px) { .review-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .review-grid { grid-template-columns: 1fr; } .review-grid a { padding-bottom: 1.5rem; } }

  /* ── Shortlists and builds ──────────────────────────────────────── */
  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .col-head {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--text-muted);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border-hover);
  }
  .entry-list { margin-bottom: 1.5rem; }
  .entry-list li { border-bottom: 1px solid var(--border); }
  .entry-list a { display: grid; gap: 0.3rem; padding: 1.15rem 0; }
  .entry-title {
    font-weight: 600;
    color: var(--text-primary);
    transition: color 160ms var(--ease-out);
  }
  .entry-title::after {
    content: ' \2192';
    display: inline-block;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }
  .entry-list a:hover .entry-title { color: var(--accent); }
  .entry-list a:hover .entry-title::after { opacity: 1; transform: none; }
  .entry-desc { color: var(--text-secondary); max-width: 60ch; }
  @media (max-width: 760px) { .columns { grid-template-columns: 1fr; } }

  /* ── Learn ──────────────────────────────────────────────────────── */
  .split-wide { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; }
  @media (max-width: 859px) { .split-wide { grid-template-columns: 1fr; } }
  .learn-main { display: grid; gap: 1.25rem; justify-items: start; }
  .learn-main .seg { margin-top: 0.75rem; }
  .path { display: none; width: 100%; }
  .learn-main:has(input[value='beginner']:checked) .path[data-key='beginner'],
  .learn-main:has(input[value='intermediate']:checked) .path[data-key='intermediate'],
  .learn-main:has(input[value='advanced']:checked) .path[data-key='advanced'] { display: block; }
  .path > p { color: var(--text-secondary); margin-bottom: 1rem; }
  .path-links { counter-reset: step; border-top: 1px solid var(--border-hover); }
  .path-links li { counter-increment: step; border-bottom: 1px solid var(--border); }
  .path-links a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    font-weight: 500;
    color: var(--text-primary);
    transition: color 160ms var(--ease-out), padding-left 200ms var(--ease-out);
  }
  /* Genuine sequence: these are reading steps, in order. */
  .path-links a::before {
    content: counter(step);
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    min-width: 1.25rem;
  }
  .path-links a:hover { color: var(--accent); }

  .loop-figure { display: grid; gap: 1rem; justify-items: center; }
  .loop-diagram { width: 100%; max-width: 420px; height: auto; overflow: visible; }
  .ld-ring { fill: none; stroke: var(--border-hover); stroke-width: 1; }
  .ld-arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 100 100;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1600ms var(--ease-out);
  }
  .ld-arrow { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; transition: opacity 400ms var(--ease-out) 1200ms; }
  .loop-figure.pending .ld-arrow { opacity: 0; transition: none; }
  .ld-node circle { fill: var(--bg); stroke: var(--text-primary); stroke-width: 2.5; transition: fill 200ms var(--ease-out); }
  .ld-node text { font-family: var(--body); font-size: 17px; font-weight: 600; fill: var(--text-primary); }
  .ld-center { font-family: var(--body); font-size: 17px; fill: var(--text-muted); }
  .loop-figure.pending .ld-arc { stroke-dashoffset: 100; transition: none; }
  .loop-figure.drawn .ld-node circle { animation: node-on 400ms var(--ease-out) both; animation-delay: calc(var(--i) * 380ms + 150ms); }
  @keyframes node-on { from { fill: var(--bg); } to { fill: var(--accent); } }
  .loop-figure:not(.pending):not(.drawn) .ld-node circle { fill: var(--accent); }
  .loop-figure figcaption { font-size: var(--text-sm); color: var(--text-muted); text-align: center; max-width: 40ch; }
  .loop-figure figcaption a { color: var(--accent); font-weight: 600; white-space: nowrap; }
  .loop-figure figcaption a:hover { color: var(--accent-hover); }
  @media (max-width: 859px) { .loop-diagram { max-width: 320px; } }

  /* ── About ──────────────────────────────────────────────────────── */
  .prose { display: grid; gap: 1.25rem; }
  .prose p { max-width: 65ch; }
  .prose a { color: var(--accent); border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); }
  .prose a:hover { color: var(--accent-hover); border-bottom-color: currentColor; }

  .section.sponsor { padding-block: 0; border-top: 0; }
  .section.sponsor:not(:has(.sponsor-banner)) { display: none; }

  /* ── Footer (ink block) ─────────────────────────────────────────── */
  .site-footer {
    background: var(--ink);
    color: var(--on-ink-muted);
    padding: clamp(3.5rem, 7vw, 5rem) 0 2rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .footer-author { display: grid; gap: 1rem; align-content: start; }
  .footer-author p { font-size: var(--text-sm); max-width: 40ch; }
  .author-row { display: flex; align-items: center; gap: 0.85rem; }
  .author-avatar { width: 3rem; height: 3rem; border-radius: 50%; object-fit: cover; }
  .author-name { font-weight: 600; color: var(--on-ink); }
  .author-handle { font-size: var(--text-sm); }
  .author-socials { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .author-socials a, .footer-col a, .footer-bottom a {
    font-size: var(--text-sm);
    color: var(--on-ink-muted);
    transition: color 160ms var(--ease-out);
  }
  .author-socials a:hover, .footer-col a:hover, .footer-bottom a:hover { color: var(--on-ink-accent); }
  .footer-col h2 { font-size: var(--text-sm); font-weight: 600; color: var(--on-ink); margin-bottom: 1rem; }
  .footer-col ul { display: grid; gap: 0.6rem; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--on-ink-rule);
    font-size: var(--text-sm);
  }
  .footer-bottom a { margin-left: 0.75rem; white-space: nowrap; }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .footer-grid { grid-template-columns: 1fr; gap: 2rem; } }

  /* ── Reduced motion ─────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .loop-figure.pending .ld-arc { stroke-dashoffset: 0; }
    .loop-figure .ld-node circle { fill: var(--accent); }
  }
</style>

</body>
</html>
