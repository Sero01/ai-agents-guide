---
import data from '../data/yc-startups.json';

interface Props {
  chart: 'outcomes' | 'funding' | 'themes' | 'odds' | 'industries' | 'regions';
  caption?: string;
}

const { chart, caption } = Astro.props;

const pct = (v: number) => `${v.toFixed(1)}%`;
const pct0 = (v: number) => `${Math.round(v)}%`;
const int = (v: number) => v.toLocaleString('en-US');
const round = (v: number) => Math.round(v * 10) / 10;

// Outcomes: stacked share of each batch year
const OUTCOMES = [
  { key: 'win', label: 'Exited or top company', color: 'var(--s1)' },
  { key: 'growing', label: 'Active, 25+ staff', color: 'var(--s3)' },
  { key: 'small', label: 'Active, under 25 staff', color: 'var(--neutral)' },
  { key: 'dead', label: 'Shut down', color: 'var(--s2)' },
] as const;
const oW = 720, oH = 330, oM = { t: 8, r: 8, b: 46, l: 44 };
const oStep = (oW - oM.l - oM.r) / data.cohorts.length;
const oBar = oStep * 0.72;
const oY = (v: number) => oM.t + (oH - oM.t - oM.b) * (1 - v / 100);
const outcomeBars = data.cohorts.map((c, i) => {
  let top = 100;
  const segments = OUTCOMES.map((o) => {
    const value = c[o.key];
    const y = oY(top);
    top -= value;
    return { color: o.color, y, height: Math.max(0, oY(top) - y - 2) };
  });
  return {
    year: c.year,
    companies: c.companies,
    x: oM.l + i * oStep,
    segments,
    tip: `${c.year}: ${int(c.companies)} companies\n${OUTCOMES.map((o) => `${o.label}: ${pct(c[o.key])}`).join('\n')}`,
  };
});

// Funding: one point per year, global VC against YC companies
const fW = 720, fH = 340, fM = { t: 14, r: 24, b: 46, l: 54 };
const fX = (v: number) => fM.l + (fW - fM.l - fM.r) * (v / 800);
const fY = (v: number) => fM.t + (fH - fM.t - fM.b) * (1 - v / 800);
const fTicks = [0, 200, 400, 600, 800];
const fLabelLeft = new Set([2025]);

// Themes: share of each batch year
const THEMES = [
  { key: 'ai', label: 'AI-tagged', color: 'var(--s1)' },
  { key: 'outside_us', label: 'Outside US/Canada', color: 'var(--s2)' },
  { key: 'fintech', label: 'Fintech', color: 'var(--s3)' },
  { key: 'consumer', label: 'Consumer', color: 'var(--s4)' },
  { key: 'healthcare', label: 'Healthcare', color: 'var(--s5)' },
  { key: 'crypto', label: 'Crypto-tagged', color: 'var(--s6)' },
] as const;
const tW = 720, tH = 380, tM = { t: 12, r: 158, b: 28, l: 44 };
const tFirst = data.themes[0].year, tLast = data.themes[data.themes.length - 1].year;
const tX = (year: number) => tM.l + (tW - tM.l - tM.r) * ((year - tFirst) / (tLast - tFirst));
const tY = (v: number) => tM.t + (tH - tM.t - tM.b) * (1 - v / 70);
const themeLines = THEMES.map((s) => ({
  ...s,
  d: data.themes.map((r, i) => `${i ? 'L' : 'M'}${round(tX(r.year))} ${round(tY(r[s.key]))}`).join(' '),
}));
const lastTheme = data.themes[data.themes.length - 1];
const themeLabels = THEMES.map((s) => ({ ...s, value: lastTheme[s.key], y: tY(lastTheme[s.key]) })).sort((a, b) => b.y - a.y);
themeLabels.reduce((below, label) => {
  label.y = Math.min(label.y, below - 15);
  return label.y;
}, tH - tM.b + 13);
const themeStep = (tW - tM.l - tM.r) / (tLast - tFirst);

// Odds: one forest plot per outcome
const FACTORS = [...new Set(data.odds.map((r) => r.factor))];
const pText = (p: number) => (p < 0.001 ? 'under 0.001' : p.toFixed(3));
const orW = 720, orRow = 26, orM = { t: 6, r: 20, b: 30, l: 186 };
const orX = (v: number) => orM.l + (orW - orM.l - orM.r) * (Math.log(Math.min(3.5, Math.max(0.3, v)) / 0.3) / Math.log(3.5 / 0.3));
const forests = [
  { outcome: 'Shut down', title: 'Odds of shutting down' },
  { outcome: 'Win or growing', title: 'Odds of exiting, top-company status, or 25+ staff' },
].map((f) => ({
  ...f,
  rows: data.odds.filter((r) => r.outcome === f.outcome),
  height: orM.t + orM.b + FACTORS.length * orRow,
}));
const rowTable = chart === 'industries' ? data.industries : data.regions;
---

<figure class="yc-viz">
  {chart === 'outcomes' && (
    <>
      <ul class="yc-legend">
        {OUTCOMES.map((o) => <li><i style={`background:${o.color}`} />{o.label}</li>)}
      </ul>
      <div class="yc-scroll">
        <svg viewBox={`0 0 ${oW} ${oH}`} role="img" aria-label="Stacked bars of outcome share for each YC batch year from 2015 to 2025. Values are in the data table below.">
          {[0, 25, 50, 75, 100].map((t) => (
            <g>
              <line class="grid" x1={oM.l} x2={oW - oM.r} y1={oY(t)} y2={oY(t)} />
              <text class="tick" x={oM.l - 8} y={oY(t)} dy="0.32em" text-anchor="end">{t}%</text>
            </g>
          ))}
          {outcomeBars.map((b) => (
            <g class="band" data-tip={b.tip}>
              <rect class="hit" x={b.x} y={oM.t} width={oStep} height={oH - oM.t - oM.b + 40} />
              {b.segments.map((s) => <rect x={b.x + (oStep - oBar) / 2} y={s.y} width={oBar} height={s.height} rx="2" style={`fill:${s.color}`} />)}
              <text class="tick strong" x={b.x + oStep / 2} y={oH - oM.b + 18} text-anchor="middle">{b.year}</text>
              <text class="tick" x={b.x + oStep / 2} y={oH - oM.b + 34} text-anchor="middle">{int(b.companies)}</text>
            </g>
          ))}
        </svg>
      </div>
      <details>
        <summary>Data table</summary>
        <table>
          <thead><tr><th>Batch year</th><th>Companies</th>{OUTCOMES.map((o) => <th>{o.label}</th>)}</tr></thead>
          <tbody>
            {data.cohorts.map((c) => <tr><td>{c.year}</td><td>{int(c.companies)}</td>{OUTCOMES.map((o) => <td>{pct(c[o.key])}</td>)}</tr>)}
          </tbody>
        </table>
      </details>
    </>
  )}

  {chart === 'funding' && (
    <>
      <div class="yc-scroll">
        <svg viewBox={`0 0 ${fW} ${fH}`} role="img" aria-label="Scatter plot of global venture funding against YC companies per year, 2020 to 2025. Values are in the data table below.">
          {fTicks.map((t) => (
            <g>
              <line class="grid" x1={fM.l} x2={fW - fM.r} y1={fY(t)} y2={fY(t)} />
              <text class="tick" x={fM.l - 8} y={fY(t)} dy="0.32em" text-anchor="end">{t}</text>
              <text class="tick" x={fX(t)} y={fH - fM.b + 18} text-anchor="middle">${t}B</text>
            </g>
          ))}
          <text class="tick" x={(fM.l + fW - fM.r) / 2} y={fH - 6} text-anchor="middle">Global venture funding that year</text>
          <text class="tick" transform={`translate(13 ${(fM.t + fH - fM.b) / 2}) rotate(-90)`} text-anchor="middle">YC companies in that year's batches</text>
          {data.funding.map((r) => (
            <g class="band" data-tip={`${r.year}\nYC companies: ${int(r.companies)}\nGlobal venture funding: $${r.vc_bn}B`}>
              <circle class="hit" cx={fX(r.vc_bn)} cy={fY(r.companies)} r="16" />
              <circle cx={fX(r.vc_bn)} cy={fY(r.companies)} r="5.5" style="fill:var(--s1)" />
              <text class="tick strong" x={fX(r.vc_bn) + (fLabelLeft.has(r.year) ? -10 : 10)} y={fY(r.companies)} dy="0.32em" text-anchor={fLabelLeft.has(r.year) ? 'end' : 'start'}>{r.year}</text>
            </g>
          ))}
        </svg>
      </div>
      <details>
        <summary>Data table</summary>
        <table>
          <thead><tr><th>Year</th><th>YC companies</th><th>Global venture funding</th></tr></thead>
          <tbody>
            {data.funding.map((r) => <tr><td>{r.year}</td><td>{int(r.companies)}</td><td>${r.vc_bn}B</td></tr>)}
          </tbody>
        </table>
      </details>
    </>
  )}

  {chart === 'themes' && (
    <>
      <ul class="yc-legend">
        {THEMES.map((s) => <li><i style={`background:${s.color}`} />{s.label}</li>)}
      </ul>
      <div class="yc-scroll">
        <svg viewBox={`0 0 ${tW} ${tH}`} role="img" aria-label="Lines showing the share of each YC batch year by theme, 2015 to 2025. Values are in the data table below.">
          {[0, 10, 20, 30, 40, 50, 60, 70].map((t) => (
            <g>
              <line class="grid" x1={tM.l} x2={tW - tM.r} y1={tY(t)} y2={tY(t)} />
              <text class="tick" x={tM.l - 8} y={tY(t)} dy="0.32em" text-anchor="end">{t}%</text>
            </g>
          ))}
          {data.themes.map((r) => <text class="tick" x={tX(r.year)} y={tH - tM.b + 18} text-anchor="middle">{r.year}</text>)}
          {themeLines.map((s) => <path class="line" d={s.d} style={`stroke:${s.color}`} />)}
          {themeLabels.map((l) => (
            <g>
              <line x1={tW - tM.r + 5} x2={tW - tM.r + 15} y1={l.y} y2={l.y} stroke-width="2" style={`stroke:${l.color}`} />
              <text class="tick strong" x={tW - tM.r + 20} y={l.y} dy="0.32em">{l.label} {pct0(l.value)}</text>
            </g>
          ))}
          {data.themes.map((r) => (
            <g class="band" data-tip={`${r.year}\n${THEMES.map((s) => `${s.label}: ${pct(r[s.key])}`).join('\n')}`}>
              <rect class="hit" x={tX(r.year) - themeStep / 2} y={tM.t} width={themeStep} height={tH - tM.t - tM.b} />
              <line class="rule" x1={tX(r.year)} x2={tX(r.year)} y1={tM.t} y2={tH - tM.b} />
            </g>
          ))}
        </svg>
      </div>
      <details>
        <summary>Data table</summary>
        <table>
          <thead><tr><th>Batch year</th>{THEMES.map((s) => <th>{s.label}</th>)}</tr></thead>
          <tbody>
            {data.themes.map((r) => <tr><td>{r.year}</td>{THEMES.map((s) => <td>{pct(r[s.key])}</td>)}</tr>)}
          </tbody>
        </table>
      </details>
    </>
  )}

  {chart === 'odds' && (
    <>
      <ul class="yc-legend">
        <li><i class="dot" />Clear result: p under 0.05</li>
        <li><i class="ring" />Not clear</li>
      </ul>
      {forests.map((f) => (
        <div class="yc-panel">
          <h4>{f.title}</h4>
          <div class="yc-scroll">
            <svg viewBox={`0 0 ${orW} ${f.height}`} role="img" aria-label={`${f.title}: odds ratios with 95% intervals. Values are in the data table below.`}>
              {[0.5, 1, 2, 3].map((t) => (
                <g>
                  <line class={t === 1 ? 'reference' : 'grid'} x1={orX(t)} x2={orX(t)} y1={orM.t} y2={f.height - orM.b} />
                  <text class="tick" x={orX(t)} y={f.height - orM.b + 18} text-anchor="middle">{t}×</text>
                </g>
              ))}
              {f.rows.map((r, i) => {
                const y = orM.t + i * orRow + orRow / 2;
                const clear = r.p < 0.05;
                return (
                  <g class="band" data-tip={`${r.factor}\nOdds ratio: ${r.or.toFixed(2)}×\n95% interval: ${r.low.toFixed(2)}× to ${r.high.toFixed(2)}×\np-value: ${pText(r.p)}`}>
                    <rect class="hit" x="0" y={y - orRow / 2} width={orW} height={orRow} />
                    <text class="tick strong" x={orM.l - 12} y={y} dy="0.32em" text-anchor="end">{r.factor}</text>
                    <line x1={orX(r.low)} x2={orX(r.high)} y1={y} y2={y} stroke-width="2" stroke-linecap="round" style={`stroke:${clear ? 'var(--s1)' : 'var(--neutral)'}`} />
                    <circle cx={orX(r.or)} cy={y} r="5" stroke-width="2" style={clear ? 'fill:var(--s1);stroke:var(--s1)' : 'fill:var(--bg);stroke:var(--neutral)'} />
                  </g>
                );
              })}
            </svg>
          </div>
        </div>
      ))}
      <details>
        <summary>Data table</summary>
        <table>
          <thead><tr><th>Factor</th><th>Outcome</th><th>Odds ratio</th><th>95% interval</th><th>p-value</th></tr></thead>
          <tbody>
            {data.odds.map((r) => <tr><td>{r.factor}</td><td>{r.outcome === 'Shut down' ? 'Shut down' : 'Exited, top, or 25+ staff'}</td><td>{r.or.toFixed(2)}×</td><td>{r.low.toFixed(2)}× to {r.high.toFixed(2)}×</td><td>{pText(r.p)}</td></tr>)}
          </tbody>
        </table>
      </details>
    </>
  )}

  {(chart === 'industries' || chart === 'regions') && (
    <table>
      <thead>
        <tr><th>{chart === 'industries' ? 'Industry' : 'Region'}</th><th>Companies</th><th>Exited or top</th><th>Active, 25+</th><th>Active, under 25</th><th>Shut down</th></tr>
      </thead>
      <tbody>
        {rowTable.map((r) => <tr><td>{r.group}</td><td>{int(r.companies)}</td><td>{pct0(r.win)}</td><td>{pct0(r.growing)}</td><td>{pct0(r.small)}</td><td>{pct0(r.dead)}</td></tr>)}
      </tbody>
    </table>
  )}

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const tip = document.createElement('div');
  tip.className = 'yc-tip';
  tip.hidden = true;
  document.body.append(tip);
  const move = (e: PointerEvent) => {
    const x = Math.min(e.clientX + 14, window.innerWidth - tip.offsetWidth - 8);
    const y = Math.min(e.clientY + 14, window.innerHeight - tip.offsetHeight - 8);
    tip.style.transform = `translate(${Math.max(8, x)}px, ${Math.max(8, y)}px)`;
  };
  document.addEventListener('pointerover', (e) => {
    const target = (e.target as Element).closest?.('.yc-viz [data-tip]');
    if (!target) {
      tip.hidden = true;
      return;
    }
    tip.textContent = target.getAttribute('data-tip');
    tip.hidden = false;
    move(e);
  });
  document.addEventListener('pointermove', (e) => {
    if (!tip.hidden) move(e);
  });
</script>

<style is:global>
  .yc-viz {
    --s1: #2a78d6;
    --s2: #eb6834;
    --s3: #1baf7a;
    --s4: #eda100;
    --s5: #e87ba4;
    --s6: #008300;
    --neutral: #a8a49d;
    margin: 1.5rem 0;
  }
  :root[data-theme='dark'] .yc-viz {
    --s1: #3987e5;
    --s2: #d95926;
    --s3: #199e70;
    --s4: #c98500;
    --s5: #d55181;
    --neutral: #6f6b65;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']):not([data-theme='dark']) .yc-viz {
      --s1: #3987e5;
      --s2: #d95926;
      --s3: #199e70;
      --s4: #c98500;
      --s5: #d55181;
      --neutral: #6f6b65;
    }
  }
  .yc-viz .yc-scroll { overflow-x: auto; }
  .yc-viz svg { display: block; width: 100%; min-width: 560px; height: auto; }
  .yc-viz svg text { font-family: var(--mono); font-size: 12px; }
  .yc-viz .tick { fill: var(--text-muted); }
  .yc-viz .tick.strong { fill: var(--text-primary); }
  .yc-viz .grid { stroke: var(--border); stroke-width: 1; }
  .yc-viz .reference { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 3; }
  .yc-viz .line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .yc-viz .hit { fill: transparent; }
  .yc-viz .rule { stroke: var(--text-muted); stroke-width: 1; opacity: 0; }
  .yc-viz .band:hover .rule { opacity: 1; }
  .yc-viz .band:hover .hit { fill: color-mix(in srgb, var(--text-primary) 6%, transparent); }
  .yc-viz .yc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .yc-viz .yc-legend li { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0; line-height: 1.4; }
  .yc-viz .yc-legend i { flex: none; margin: 0; width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
  .yc-viz .yc-legend .dot { border-radius: 50%; background: var(--s1); }
  .yc-viz .yc-legend .ring { border-radius: 50%; border: 2px solid var(--neutral); }
  .yc-viz .yc-panel h4 { font-size: 0.95rem; margin: 1rem 0 0.25rem; }
  .yc-viz details { margin-top: 0.5rem; font-size: 0.85rem; }
  .yc-viz summary { cursor: pointer; color: var(--text-muted); }
  .yc-viz figcaption { margin-top: 0.5rem; font-size: 0.85rem; color: var(--text-muted); }
  .yc-tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    max-width: 20rem;
    padding: 0.4rem 0.6rem;
    white-space: pre-line;
    font-size: 0.8rem;
    line-height: 1.5;
    pointer-events: none;
    color: var(--text-primary);
    background: var(--bg-card, var(--bg));
    border: 1px solid var(--border);
    border-radius: 4px;
  }
</style>
